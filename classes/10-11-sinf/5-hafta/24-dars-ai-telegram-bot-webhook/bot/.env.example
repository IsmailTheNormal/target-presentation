# Target International School // 10-11-Sinf 24-Dars
# Shaxsiy AI Telegram Bot Sozlamalari

# 1. Telegram Bot Token (@BotFather dan olingan maxfiy token)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# 2. AI Model API Kaliti (Groq / OpenRouter / DeepSeek)
# Eslatma: Agar kalit kiritilmasa, bot sinov uchun aqlli simulyatsiya rejimida ishlaydi!
GROQ_API_KEY=gsk_your_groq_api_key_here

# 3. Server Porti (VS Code Dev Tunnels shu portni Forward qiladi)
PORT=3000

# 4. Bot Shaxsiyati (System Prompt)
BOT_SYSTEM_PROMPT="Sen Target International School ning 10-11-sinf o'quvchilari uchun maxsus yaratilgan do'stona va aqlli AI assistentsan. Savollarga aniq, ixcham va qiziqarli javob ber. O'zbek tilida so'zlash."
